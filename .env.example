# Copia este archivo a .env y reemplaza los valores CHANGE_ME_*.
# Más fácil: ejecuta ./scripts/init-env.sh (Linux/macOS) o .\scripts\init-env.ps1 (Windows),
# que genera contraseñas aleatorias. NO subas .env al repositorio.

# --- Secretos (obligatorios) ---
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
SECRET_KEY=CHANGE_ME_SECRET_KEY_AT_LEAST_32_CHARS

# --- Administrador inicial (opcional) ---
# Si defines las tres, se crea automáticamente en el primer arranque (si no existe ningún admin).
# Alternativa más segura: dejarlas vacías y ejecutar
#   docker compose exec api python -m app.cli create-admin --username admin --email admin@ejemplo.cl
# (pide la contraseña por consola sin eco).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Vision Lab

# --- Red / acceso ---
HTTP_PORT=8180
PUBLIC_URL=http://localhost:8180
# Pon true si publicas la plataforma detrás de HTTPS
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Documentación interactiva de la API en /api/docs (sólo para desarrollo)
API_DOCS=false

# --- Cuotas y reglas ---
DEFAULT_USER_QUOTA_MB=102400
MAX_UPLOAD_MB=15
MAX_AUDIO_UPLOAD_MB=50
MAX_TABULAR_UPLOAD_MB=50
MIN_IMAGES_PER_CLASS=10
LOW_CONFIDENCE_THRESHOLD=0.6

# --- RAM (el total por defecto suma ~18,9 GB; máximo configurable 20 GB) ---
TOTAL_RAM_LIMIT_GB=20
TRAIN_MEM_LIMIT=14g
API_MEM_LIMIT=2g
DB_MEM_LIMIT=1g
REDIS_MEM_LIMIT=512m
LIGHT_MEM_LIMIT=2g
BEAT_MEM_LIMIT=256m
WEB_MEM_LIMIT=128m
# Hilos de CPU para TensorFlow (0 = automático)
TRAIN_THREADS=0

# --- Entrenamiento nocturno (lunes a viernes, hora local) ---
# Entrena de noche los modelos que tardan como máximo NIGHT_MAX_JOB_HOURS y caben en la ventana;
# sólo se bloquea el proyecto que se entrena. El sábado se entrena el resto (del más largo al más corto).
NIGHT_TRAINING_ENABLED=true
NIGHT_WINDOW_START=00:00
NIGHT_WINDOW_END=08:00
NIGHT_MAX_JOB_HOURS=4
# Si alguien modificó el proyecto hace menos de esto, se le pregunta si le faltan cargas
NIGHT_ACTIVITY_MINUTES=15
NIGHT_ASK_TIMEOUT_MINUTES=20

# --- Importación desde Hugging Face ---
# Clave con la que se cifran los tokens de Hugging Face que cada usuario conecta en «Mi cuenta».
# init-env la genera sola. Si la dejas vacía se deriva de SECRET_KEY (funciona, pero cambiar SECRET_KEY
# obligaría a todos a reconectar su cuenta). Guárdala en el respaldo del .env: si se pierde, hay que reconectar.
# Generar una:  docker compose exec api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HF_ENCRYPTION_KEY=CHANGE_ME_HF_ENCRYPTION_KEY
# Tamaño máximo de una importación (GB). El espacio sigue limitado por la cuota del usuario.
HF_IMPORT_MAX_GB=5

# --- Correo SMTP (opcional; sin SMTP las notificaciones internas siguen funcionando) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Almacenamiento (imágenes, snapshots, modelos) ---
# Vacío = volumen Docker interno. Para usar otro disco, pon su ruta, p. ej.:
#   Windows: DATA_PATH=E:/vision-datos        Linux: DATA_PATH=/mnt/disco2/vision
# (la carpeta debe existir; en Linux: sudo chown -R 1000:1000 /mnt/disco2/vision)
DATA_PATH=

# --- Acceso público con Cloudflare Tunnel (opcional) ---
# Token del túnel (Zero Trust > Networks > Tunnels > tu túnel > Install connector > el texto tras --token).
# Public Hostname del túnel:  vision.tu-dominio  ->  HTTP  web:80
# Luego:  docker compose --profile tunnel up -d tunnel
# Con HTTPS activa también COOKIE_SECURE=true y PUBLIC_URL=https://vision.tu-dominio
CLOUDFLARE_TUNNEL_TOKEN=
