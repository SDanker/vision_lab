# Normaliza finales de línea. Los scripts de shell y el Dockerfile deben ser LF
# (si llegan con CRLF fallan dentro de los contenedores Linux).
* text=auto

*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
